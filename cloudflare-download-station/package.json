{
  "name": "download-station",
  "version": "1.0.0",
  "private": true,
  "description": "超炫酷应用及插件下载站（Cloudflare Workers + D1 + R2 + 纯前端）",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute download-station-db --file=./schema.sql",
    "db:remote": "wrangler d1 execute download-station-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
